# ---- required -------------------------------------------------------------
# From @BotFather. NEVER commit this file with a real token.
BOT_TOKEN=
# Comma-separated Telegram user IDs. OWNER_IDS may /setca and /setlinks.
OWNER_IDS=
ADMIN_IDS=
# The community group's chat id (negative number, e.g. -100123...). Strongly recommended.
GROUP_ID=
# Optional: chat/channel where moderation actions are logged (add the bot there).
LOG_CHAT_ID=

# ---- official info (leave empty until real) --------------------------------
# Empty => the bot says "COMING SOON". Invalid values stop the bot at startup.
BULLSHIT_CA=
OFFICIAL_X=https://x.com/BullShit_Solana
OFFICIAL_WEBSITE=https://bullshit-site.vercel.app
BUY_LINK=
TELEGRAM_LINK=

# ---- behaviour ---------------------------------------------------------------
VERIFY_ENABLED=true
VERIFY_TIMEOUT_SECONDS=180
PROBATION_HOURS=24
FLOOD_MESSAGES=6
FLOOD_SECONDS=8
REPEAT_LIMIT=3
MUTE_MINUTES=10
MAX_LINKS=2
WARN_MUTE_AT=3
WARN_BAN_AT=5
SCAM_WARN_SCORE=3
SCAM_DELETE_SCORE=5
SCAM_BAN_SCORE=8
# Extra hosts links may point to, comma separated (e.g. solscan.io,birdeye.so)
LINK_ALLOWLIST=

DATABASE_PATH=data/bullshit.sqlite3
LOG_LEVEL=INFO
